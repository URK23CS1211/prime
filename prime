using System;

class Program
{
    static void Main()
    {
        int count = 0;
        int num = 2;

        while (count < 50)
        {
            bool prime = true;

            for (int i = 2; i <= Math.Sqrt(num); i++)
            {
                if (num % i == 0)
                {
                    prime = false;
                    break;
                }
            }

            if (prime)
            {
                Console.Write(num + " ");
                count++;
            }

            num++;
        }
    }
}
